<?xml version="1.0" encoding="utf-8"?>
<!--
  TeumesseCastle - shared MSBuild properties for every project in this repository.

  The product targets .NET Framework 4.5.2 (same as PingCastle 3.0.0.0). The SDK restores the matching
  reference assemblies from NuGet (Microsoft.NETFramework.ReferenceAssemblies), so `dotnet build` works on
  any Windows machine with a .NET SDK and no targeting pack installed.
-->
<Project>

  <PropertyGroup>
    <!-- Single source of truth for the product version (shown by - -version and in the reports). -->
    <TeumesseCastleVersion>1.0.0</TeumesseCastleVersion>
  </PropertyGroup>

</Project>
