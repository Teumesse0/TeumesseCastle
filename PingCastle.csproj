<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TeumesseCastle main project.

    Converted from the legacy (ToolsVersion 4.0) PingCastle 3.0.0.0 project file to the SDK format so that
    `dotnet build` restores NuGet packages and builds without a Visual Studio installation.
    The target framework is unchanged: .NET Framework 4.5.2 (see docs/DECISIONS.md, ADR-0002).
  -->

  <PropertyGroup>
    <TargetFramework>net452</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>PingCastle</RootNamespace>
    <AssemblyName>PingCastle</AssemblyName>
    <ApplicationIcon>pingcastle.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <FileAlignment>512</FileAlignment>
    <WarningLevel>4</WarningLevel>
    <!-- CS0436: a type in Compatibility.cs intentionally shadows a framework type (same as upstream). -->
    <NoWarn>0436</NoWarn>

    <!-- Keep the historical layout and behaviour of the legacy project. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>

    <!-- Folders that must never be globbed into this project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);PingCastleAutoUpdater/**;reference/**;docs/**;assets/**;tools/**;.github/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- Framework assemblies (identical list to the upstream project). -->
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.DirectoryServices" />
    <Reference Include="System.DirectoryServices.Protocols" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Web" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <!--
    Source files present in the repository but NOT compiled by the upstream project (dead code kept for
    traceability). They are excluded here to keep strict parity with PingCastle 3.0.0.0.
  -->
  <ItemGroup>
    <Compile Remove="ADWS\BlockingQueue.cs" />
    <Compile Remove="Healthcheck\Healthcheck.cs" />
    <Compile Remove="Healthcheck\Rules\HeatlcheckRuleStaledSIDHistoryComputer.cs" />
    <Compile Remove="Rules\RiskModelObjective.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Cloud\UI\AuthenticationDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Cloud\UI\AuthenticationDialog.Designer.cs">
      <DependentUpon>AuthenticationDialog.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Cloud\UI\AuthenticationDialog.resx">
      <DependentUpon>AuthenticationDialog.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Gzipped HTML/CSS/JS templates embedded in the executable (loaded by template\TemplateManager.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="template\*.gz" />
    <!-- Present in the folder but not embedded by the upstream project (kept out for strict parity). -->
    <EmbeddedResource Remove="template\dashboardtest.html.gz" />
    <EmbeddedResource Remove="template\dataTables.bootstrap4.min.css.gz" />
    <EmbeddedResource Remove="template\dataTables.bootstrap4.min.js.gz" />
    <EmbeddedResource Remove="template\jquery.dataTables.min.js.gz" />
  </ItemGroup>

  <!-- Regenerate the gzipped templates when their source changed (same pre-build step as upstream). -->
  <Target Name="ProcessTemplates" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell.exe -ExecutionPolicy Bypass -NoProfile -NonInteractive -File &quot;ProcessTemplate.ps1&quot;" WorkingDirectory="$(MSBuildProjectDirectory)\template" />
  </Target>

</Project>
